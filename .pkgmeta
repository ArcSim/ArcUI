# CurseForge / BigWigs packager metadata.
# If you ever connect this repo to CurseForge's automatic packager (it builds the
# zip for you on each GitHub release), everything listed under `ignore` is left
# OUT of the packaged addon. This file is also the single source of truth for the
# exclude list used by package.ps1.
package-as: ArcUI

# Use our formatted changelog for the CurseForge file notes (instead of the
# packager's auto-generated commit-message list).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .git
  - .github
  - .gitignore
  - .gitattributes
  - .claude
  - CLAUDE.md
  - .pkgmeta
  - package.ps1
  - CHANGELOG_*.md
  - "*.bak"
  # Community bar textures/fonts: the registration file is not in the toc, so
  # nothing here is reachable in game. Kept in the repo, left out of the zip
  # until the feature is switched back on (re-add the toc line + drop these
  # two entries to ship it).
  - CustomTextures
  - Utilities/ArcUI_CustomTextures.lua
